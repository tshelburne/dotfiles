{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Create(./**)",
      "Write(./**)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(git:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(npx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(find:*)",
      "Bash(open:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(which:*)",
      "Bash(command:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(wc:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)"
    ],
    "deny": [
      "Write(/)",
      "Edit(/)",
      "Read(/etc/**)",
      "Bash(rm -rf /*)",
      "Bash(shutdown:*)",
      "Read(./**/secrets/**)",
      "Skill(github-practices:qa-evidence)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(apt-get:*)",
      "Bash(brew:*)",
      "Bash(pnpm dlx:*)",
      "Read(./.env)",
      "Bash(~/.claude/skills/kill-project-processes/kill-project-processes.sh:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/gate-kill-project-processes.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "project-architecture@tshelburne": true,
    "dev-environment@tshelburne": true,
    "github-practices@tshelburne": true
  },
  "extraKnownMarketplaces": {
    "tshelburne": {
      "source": {
        "source": "github",
        "repo": "tshelburne/claude-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
